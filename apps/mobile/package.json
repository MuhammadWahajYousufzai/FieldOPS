{
  "name": "@fieldops/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "ios:asc:upload": "bash ./scripts/ios-app-store-connect.sh upload",
