{
    "organizationId": "69b548e1000b4915db9c",
    "projectId": "6a771dd900066ce5c125",
    "projectName": "FieldOPS",
    "endpoint": "https://yousufricemill.com/v1",
    "sites": [
        {
      "$id": "fieldops-dashboard",
      "name": "FieldOPS Management Dashboard",
      "logging": true,
      "timeout": 60,
            "framework": "nextjs",
            "buildRuntime": "node-22",
            "adapter": "ssr",
            "installCommand": "npm install -g pnpm@11.18.0 && pnpm install --frozen-lockfile",
            "buildCommand": "pnpm --filter @fieldops/web build",
            "startCommand": "",
            "outputDirectory": "apps/web/.next",
            "buildSpecification": "s-1vcpu-1gb",
      "runtimeSpecification": "s-8vcpu-8gb",
      "deploymentRetention": 5,
      "installationId": "6a78cdcd2ac6ad663c6b",
      "providerRepositoryId": "1323882895",
      "providerBranch": "main",
      "providerSilentMode": false,
      "providerRootDirectory": ".",
      "path": "."
        }
    ],
    "functions": [
        {
            "$id": "evidence-retention",
            "name": "FieldOPS Evidence Retention",
            "enabled": true,
            "logging": true,
            "runtime": "node-22",
            "buildSpecification": "s-1vcpu-512mb",
            "runtimeSpecification": "s-1vcpu-512mb",
            "deploymentRetention": 7,
            "scopes": ["rows.read", "rows.write", "files.read", "files.write"],
            "events": [],
            "schedule": "17 * * * *",
            "timeout": 60,
            "entrypoint": "src/main.js",
            "commands": "npm install",
            "installationId": "6a78cdcd2ac6ad663c6b",
            "providerRepositoryId": "1323882895",
            "providerBranch": "main",
            "providerSilentMode": false,
            "providerRootDirectory": "functions/evidence-retention",
            "providerBranches": ["main"],
            "providerPaths": ["functions/evidence-retention/**"],
            "ignore": "node_modules\n.tmp",
            "path": "functions/evidence-retention"
        }
    ],
    "settings": {
        "services": {
            "account": true,
            "avatars": true,
            "databases": true,
            "locale": true,
            "health": true,
            "storage": true,
            "teams": true,
            "users": true,
            "sites": true,
            "functions": true,
            "graphql": true,
            "messaging": true
        },
        "protocols": {
            "rest": true,
            "graphql": true,
            "websocket": true
        },
        "auth": {
            "methods": {
                "jwt": false,
                "phone": false,
                "invites": false,
                "anonymous": false,
                "email-otp": false,
                "magic-url": false,
                "email-password": true
            },
            "security": {
                "duration": 7776000,
                "limit": null,
                "sessionsLimit": 10,
                "passwordHistory": 5,
                "passwordDictionary": true,
                "personalDataCheck": true,
                "sessionAlerts": false,
                "mockNumbers": []
            }
        }
    }
}
