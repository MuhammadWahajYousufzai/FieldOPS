# Local migration / audit access. Endpoint and project ID normally come from
# appwrite.config.json; only the API key belongs in the uncommitted root .env.
APPWRITE_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=fieldops
APPWRITE_API_KEY=server-only-never-commit
APPWRITE_DATABASE_ID=fieldops

# Appwrite Sites server runtime.
APPWRITE_EVIDENCE_BUCKET_ID=visit-evidence
FIELDOPS_INITIAL_PASSWORD=replace-with-a-strong-management-dashboard-password

# One-time development seed only; do not configure this on the deployed site.
FIELDOPS_SEED_SALESPERSON_PASSWORD=replace-with-a-different-field-user-password

# Compiled into the mobile app.
EXPO_PUBLIC_API_BASE_URL=https://fieldops.example.com/api/v1
